# API pusat Seputar Jaminan. Ini hanya daftar kontrak konfigurasi, bukan secret.
# File runtime production harus berada di luar source/release dan hanya dapat
# dibaca oleh Unix user API.

NODE_ENV=production
LOG_LEVEL=info
SJ_API_HOST=127.0.0.1
SJ_API_PORT=

# Empat login PostgreSQL berbeda pada database pusat yang sama.
SJ_REGISTRY_DATABASE_URL=
SJ_INGEST_DATABASE_URL=
SJ_PUBLIC_DATABASE_URL=
SJ_OPS_DATABASE_URL=

# Redis pusat dengan credential/namespace yang tidak dipakai instalasi Ruwang.
SJ_REDIS_URL=

# Wajib dikunci setelah hostname pilot dipilih.
SJ_PUBLIC_API_BASE_URL=
SJ_PUBLIC_MEDIA_BASE_URL=

# Provider awal sesuai keputusan: filesystem persistent di luar release.
# Kerangka S3-compatible sudah tersedia untuk perpindahan tanpa perubahan fitur.
SJ_STORAGE_PROVIDER=FILESYSTEM
SJ_STORAGE_ROOT=
SJ_STORAGE_STOP_FREE_BYTES=
SJ_S3_ENDPOINT=
SJ_S3_REGION=
SJ_S3_BUCKET=
SJ_S3_ACCESS_KEY_ID=
SJ_S3_SECRET_ACCESS_KEY=
SJ_S3_FORCE_PATH_STYLE=true

# Nilai final ditentukan dari audit kapasitas dan load test, bukan ditebak.
SJ_RATE_LIMIT_INGEST_PER_MINUTE=
SJ_RATE_LIMIT_PUBLIC_PER_MINUTE=
SJ_RATE_LIMIT_OPS_AUTH_PER_MINUTE=

# Dibuat pada host pilot dan tidak pernah disimpan di Git.
SJ_OPS_ENCRYPTION_KEY_BASE64=
SJ_OPS_SESSION_SECRET=

# Onboarding bertahap: seluruh kemampuan mati sebelum gate masing-masing lulus.
SJ_PUBLIC_SITE_ENABLED=false
SJ_INGEST_ENABLED=false
SJ_MEDIA_UPLOAD_ENABLED=false
