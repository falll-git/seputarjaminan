{
  "name": "@seputarjaminan/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "ops:bootstrap": "tsx scripts/bootstrap-ops-user.ts",
    "start": "node dist/server.mjs",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.1.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@seputarjaminan/config": "1.0.0",
    "@seputarjaminan/contracts": "1.0.0",
    "@seputarjaminan/storage": "1.0.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.19",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.3",
    "esbuild": "0.28.2",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
