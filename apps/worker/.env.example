# Worker pusat Seputar Jaminan. Ini hanya daftar kontrak konfigurasi, bukan secret.
# File runtime production harus berada di luar source/release dan hanya dapat
# dibaca oleh Unix user worker.

NODE_ENV=production
LOG_LEVEL=info

# Worker hanya menerima credential database worker least-privilege.
SJ_WORKER_DATABASE_URL=

# Redis pusat dipakai hanya untuk heartbeat minimal worker.
SJ_REDIS_URL=

# Root/provider harus sama dengan API, tetapi credential file tetap terpisah.
SJ_STORAGE_PROVIDER=FILESYSTEM
SJ_STORAGE_ROOT=
SJ_STORAGE_STOP_FREE_BYTES=
SJ_S3_ENDPOINT=
SJ_S3_REGION=
SJ_S3_BUCKET=
SJ_S3_ACCESS_KEY_ID=
SJ_S3_SECRET_ACCESS_KEY=
SJ_S3_FORCE_PATH_STYLE=true

SJ_MALWARE_SCAN_MODE=CLAMAV
SJ_CLAMDSCAN_COMMAND=clamdscan
# Local Docker alternative only; leave absent on VPS/production.
# SJ_CLAMAV_DOCKER_CONTAINER=sj-local-clamav

# Tetap mati sampai database, storage, scanner, dan rollback pilot lulus.
SJ_WORKER_ENABLED=false
SJ_WORKER_HEARTBEAT_KEY=seputarjaminan:worker-heartbeat:central
SJ_WORKER_HEARTBEAT_INTERVAL_MS=5000
SJ_WORKER_HEARTBEAT_TTL_MS=15000
