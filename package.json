{
  "name": "seputarjaminan",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/generate-prisma-client.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run contracts:test && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "npm run contracts:test && npm test --workspace @seputarjaminan/api && npm test --workspace @seputarjaminan/worker && npm test --workspace @seputarjaminan/config && npm test --workspace @seputarjaminan/storage",
    "test:integration": "npm run test:integration --workspace @seputarjaminan/api",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/generate-prisma-client.mjs",
    "ci:database:provision": "node scripts/ci-provision-postgres.mjs",
    "ci:database:verify": "node scripts/ci-verify-database.mjs",
    "ci:redis:verify": "node scripts/ci-verify-redis.mjs",
    "ci:migrations:check": "node scripts/check-migration-integrity.mjs",
    "ci:repository:audit": "node scripts/audit-repository.mjs",
    "config:production:validate": "npm test --workspace @seputarjaminan/config",
    "contracts:generate": "npm run generate --workspace @seputarjaminan/contracts",
    "contracts:verify": "npm run verify --workspace @seputarjaminan/contracts",
    "contracts:test": "npm test --workspace @seputarjaminan/contracts"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@seputarjaminan/contracts": "1.0.0",
    "embla-carousel-react": "^8.6.0",
    "motion": "^13.1.1",
    "next": "16.3.4",
    "photoswipe": "5.4.4",
    "react": "19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.4",
    "@playwright/test": "1.61.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "^17.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prisma": "^7.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "5.0.9",
    "deepmerge-ts": "8.0.2",
    "esbuild": "0.28.2",
    "fast-uri": "3.1.7",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "mysql2": "3.24.3",
    "qs": "6.16.0"
  },
  "type": "module"
}
